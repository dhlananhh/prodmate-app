# Application environment
# Options: development | production | test
NODE_ENV=development
PORT=4000

# Database connection (MariaDB via Prisma)
# Example: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://root:password@localhost:3306/prodmate

# JWT secret key for authentication
JWT_SECRET=your_jwt_secret_here

# Reset secret key (used for password reset tokens)
RESET_SECRET=your_reset_secret_here

# Logging level
# Options: error | warn | info | http | debug
LOG_LEVEL=info

# Paths to private/public keys (for JWT RS256 or other crypto usage)
PRIVATE_KEY_PATH=./keys/private.pem
PUBLIC_KEY_PATH=./keys/public.pem

# SMTP configuration for sending emails
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=reset@localhost.com
