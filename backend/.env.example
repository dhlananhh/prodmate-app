# Application environment
NODE_ENV = "development"
PORT = 3000

# Database connection (MariaDB via Prisma)
# Example: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DB_URL = "mysql://root:password@localhost:3306/prodmate"

# JWT secret key for authentication (to be set later)
JWT_SECRET = "your_jwt_secret_here"

# Logging level (optional: info, debug, error, http)
LOG_LEVEL = info
